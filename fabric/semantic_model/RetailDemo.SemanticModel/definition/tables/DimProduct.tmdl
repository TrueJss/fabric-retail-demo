/// DimProduct — product dimension with category hierarchy flattened into the row.
/// Power BI hierarchy: CategoryName → ProductName

table DimProduct

	partition DimProduct = m
		mode: import
		source =
			let
				Source   = Sql.Database("WAREHOUSE_SQL_ENDPOINT", "RetailDemo_Warehouse"),
				goldView = Source{[Schema = "gold", Item = "vw_DimProduct"]}[Data]
			in
				goldView

	column ProductSK
		dataType: int64
		isHidden: true
		sourceColumn: ProductSK

	column ProductID
		dataType: int64
		isHidden: true
		sourceColumn: ProductID

	column CategoryID
		dataType: int64
		isHidden: true
		sourceColumn: CategoryID

	column CategoryName
		dataType: string
		sourceColumn: CategoryName

	column ProductName
		dataType: string
		sourceColumn: ProductName

	column CostPrice
		dataType: decimal
		sourceColumn: CostPrice
		formatString: "$#,##0.00"
		summarizeBy: none

	column RetailPrice
		dataType: decimal
		sourceColumn: RetailPrice
		formatString: "$#,##0.00"
		summarizeBy: none

	column MarginPct
		dataType: decimal
		sourceColumn: MarginPct
		formatString: "0.00%"
		summarizeBy: none

	hierarchy 'Product Hierarchy'
		level Category
			column: CategoryName
		level Product
			column: ProductName
