/// DimCustomer — customer dimension.
/// Region column is the RLS control column. The "Regional Sales Manager" role
/// applies a row filter on this table using USERPRINCIPALNAME() → UserRegionMapping.
/// The filter propagates to FactSales via the CustomerSK relationship.

table DimCustomer

	partition DimCustomer = m
		mode: import
		source =
			let
				Source   = Sql.Database("tuksaiygj4tunec3lfrsezppjq-7bwxheoawaye5kumzfsofchjf4.datawarehouse.fabric.microsoft.com", "RetailDemo_Warehouse"),
				goldView = Source{[Schema = "gold", Item = "vw_DimCustomer"]}[Data]
			in
				goldView

	column CustomerSK
		dataType: int64
		isHidden: true
		sourceColumn: CustomerSK

	column CustomerID
		dataType: int64
		isHidden: true
		sourceColumn: CustomerID

	column FirstName
		dataType: string
		sourceColumn: FirstName

	column LastName
		dataType: string
		sourceColumn: LastName

	column FullName
		dataType: string
		sourceColumn: FullName

	column Email
		dataType: string
		sourceColumn: Email

	column Phone
		dataType: string
		sourceColumn: Phone

	column AddressStreet
		dataType: string
		sourceColumn: AddressStreet

	column AddressCity
		dataType: string
		sourceColumn: AddressCity

	column AddressState
		dataType: string
		sourceColumn: AddressState

	/// RLS control column. Filtered by the Regional Sales Manager role.
	column Region
		dataType: string
		sourceColumn: Region

	column RegistrationDate
		dataType: dateTime
		sourceColumn: RegistrationDate
		formatString: Short Date
