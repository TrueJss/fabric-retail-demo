{
  "name": "pl_bronze_ingest",
  "properties": {
    "description": "Copies raw source files from /Files/raw_upload/ into the Bronze layer at /Files/bronze/{source}/{yyyy/MM/dd}/. All five Copy Activities execute in parallel. Replace LAKEHOUSE_ID with your Fabric Lakehouse artifact GUID before importing.",
    "parameters": {
      "p_load_date": {
        "type": "string",
        "defaultValue": "",
        "description": "Load date in yyyy-MM-dd format. Defaults to pipeline trigger date when left empty."
      }
    },
    "variables": {
      "v_load_date": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "set_load_date",
        "description": "Resolves p_load_date to today's date when the parameter is not supplied by the caller.",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "v_load_date",
          "value": {
            "value": "@if(empty(pipeline().parameters.p_load_date), formatDateTime(utcNow(), 'yyyy/MM/dd'), formatDateTime(pipeline().parameters.p_load_date, 'yyyy/MM/dd'))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "copy_orders_csv",
        "description": "Copies orders.csv from raw_upload to bronze/orders/{yyyy/MM/dd}/.",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "set_load_date",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "BinaryReadSettings"
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "LakehouseWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            }
          },
          "enableStaging": false,
          "validateDataConsistency": false
        },
        "inputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": "raw_upload/orders.csv"
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": {
                "value": "@concat('bronze/orders/', variables('v_load_date'), '/orders.csv')",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "copy_stores_csv",
        "description": "Copies stores.csv from raw_upload to bronze/stores/{yyyy/MM/dd}/.",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "set_load_date",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "BinaryReadSettings"
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "LakehouseWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            }
          },
          "enableStaging": false,
          "validateDataConsistency": false
        },
        "inputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": "raw_upload/stores.csv"
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": {
                "value": "@concat('bronze/stores/', variables('v_load_date'), '/stores.csv')",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "copy_products_xlsx",
        "description": "Copies products.xlsx from raw_upload to bronze/products/{yyyy/MM/dd}/.",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "set_load_date",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "BinaryReadSettings"
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "LakehouseWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            }
          },
          "enableStaging": false,
          "validateDataConsistency": false
        },
        "inputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": "raw_upload/products.xlsx"
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": {
                "value": "@concat('bronze/products/', variables('v_load_date'), '/products.xlsx')",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "copy_customers_json",
        "description": "Copies customers.json from raw_upload to bronze/customers/{yyyy/MM/dd}/.",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "set_load_date",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "BinaryReadSettings"
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "LakehouseWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            }
          },
          "enableStaging": false,
          "validateDataConsistency": false
        },
        "inputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": "raw_upload/customers.json"
            }
          }
        ],
        "outputs": [
          {
