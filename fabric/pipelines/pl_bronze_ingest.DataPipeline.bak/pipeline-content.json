            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": {
                "value": "@concat('bronze/customers/', variables('v_load_date'), '/customers.json')",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "copy_returns_json",
        "description": "Copies returns.json from raw_upload to bronze/returns/{yyyy/MM/dd}/.",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "set_load_date",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "BinaryReadSettings"
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "LakehouseWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            }
          },
          "enableStaging": false,
          "validateDataConsistency": false
        },
        "inputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": "raw_upload/returns.json"
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_lakehouse_binary",
            "type": "DatasetReference",
            "parameters": {
              "lakehouse_id": "31e591ee-c81f-49f8-9c1e-f8410811538a",
              "file_path": {
                "value": "@concat('bronze/returns/', variables('v_load_date'), '/returns.json')",
                "type": "Expression"
              }
            }
          }
        ]
      }
    ],
    "datasets": [
      {
        "name": "ds_lakehouse_binary",
        "description": "Parameterised binary dataset for the Retail Demo Lakehouse. Accepts any file path within the Lakehouse Files section.",
        "type": "Binary",
        "typeProperties": {
          "location": {
            "type": "LakehouseLocation",
            "lakehouseId": {
              "value": "@dataset().lakehouse_id",
              "type": "Expression"
            },
            "fileName": {
              "value": "@dataset().file_path",
              "type": "Expression"
            }
          }
        },
        "parameters": {
          "lakehouse_id": {
            "type": "String"
          },
          "file_path": {
            "type": "String"
          }
        }
      }
    ],
    "annotations": [],
    "concurrency": 1,
    "policy": {
      "elapsedTimeMetric": {}
    }
  }
}
