{
  "name": "pl_master_load",
  "properties": {
    "description": "End-to-end orchestration pipeline for the Retail Demo. Execution order: (1) Bronze ingestion via pl_bronze_ingest child pipeline, (2) four Silver notebooks in parallel + nb_silver_returns after nb_silver_orders completes, (3) three dimension stored procedures in parallel, (4) FactSales stored procedure after all dimensions are loaded. Replace all placeholder GUIDs before importing.",
    "activities": [

      {
        "name": "execute_bronze_pipeline",
        "description": "Calls pl_bronze_ingest as a child pipeline. Waits for all five Copy Activities to succeed before proceeding to Silver.",
        "type": "ExecutePipeline",
        "dependsOn": [],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_bronze_ingest",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {}
        }
      },

      {
        "name": "run_nb_silver_orders",
        "description": "Cleans and types orders.csv → silver_orders Delta table. Must complete before nb_silver_returns runs (referential integrity check).",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "execute_bronze_pipeline",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "68c2adcb-0111-476d-a475-6adbd0aeea82",
          "workspaceId": "91736df8-b0c0-4e30-aa8c-c964e288e92f",
          "parameters": {}
        }
      },

      {
        "name": "run_nb_silver_stores",
        "description": "Cleans and types stores.csv → silver_stores Delta table. Runs in parallel with other Silver notebooks.",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "execute_bronze_pipeline",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "6933c3b6-b9db-4123-82a1-5d396baf5b50",
          "workspaceId": "91736df8-b0c0-4e30-aa8c-c964e288e92f",
          "parameters": {}
        }
      },

      {
        "name": "run_nb_silver_products",
        "description": "Reads both sheets of products.xlsx, joins Products + Categories → silver_products Delta table. Runs in parallel with other Silver notebooks.",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "execute_bronze_pipeline",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "fc68cef0-0af4-4023-a0b7-572f1c3934b6",
          "workspaceId": "91736df8-b0c0-4e30-aa8c-c964e288e92f",
          "parameters": {}
        }
      },

      {
        "name": "run_nb_silver_customers",
        "description": "Flattens nested address JSON, cleans customers → silver_customers Delta table. Runs in parallel with other Silver notebooks.",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "execute_bronze_pipeline",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "6038f1bd-6fb1-464e-b405-35906dae8c56",
          "workspaceId": "91736df8-b0c0-4e30-aa8c-c964e288e92f",
          "parameters": {}
        }
      },

      {
        "name": "run_nb_silver_returns",
        "description": "Cleans returns JSON and validates every order_id against silver_orders (left_anti join). Runs AFTER nb_silver_orders to guarantee silver_orders exists for the integrity check.",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "run_nb_silver_orders",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "2a0abb78-97d3-4617-898f-b12eca1b754a",
          "workspaceId": "91736df8-b0c0-4e30-aa8c-c964e288e92f",
          "parameters": {}
        }
      },

      {
        "name": "exec_usp_Load_DimCustomer",
        "description": "MERGE from silver_customers → gold.DimCustomer. Runs after all Silver notebooks complete.",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "run_nb_silver_customers",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_returns",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_stores",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_products",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "storedProcedureName": "gold.usp_Load_DimCustomer"
        },
        "linkedServiceName": {
          "referenceName": "5745b65d-7345-433c-ada0-4d9c6f1f6554",
          "type": "LinkedServiceReference"
        }
      },

      {
        "name": "exec_usp_Load_DimProduct",
        "description": "MERGE from silver_products → gold.DimProduct. Runs in parallel with DimCustomer and DimStore.",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "run_nb_silver_customers",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_returns",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_stores",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_products",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "storedProcedureName": "gold.usp_Load_DimProduct"
        },
        "linkedServiceName": {
          "referenceName": "5745b65d-7345-433c-ada0-4d9c6f1f6554",
          "type": "LinkedServiceReference"
        }
      },

      {
        "name": "exec_usp_Load_DimStore",
        "description": "MERGE from silver_stores → gold.DimStore. Runs in parallel with DimCustomer and DimProduct.",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "run_nb_silver_customers",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_returns",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_stores",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "run_nb_silver_products",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "storedProcedureName": "gold.usp_Load_DimStore"
        },
        "linkedServiceName": {
          "referenceName": "5745b65d-7345-433c-ada0-4d9c6f1f6554",
          "type": "LinkedServiceReference"
        }
      },

      {
        "name": "exec_usp_Load_FactSales",
        "description": "TRUNCATE + INSERT from silver_orders → gold.FactSales with full SK resolution. Runs only after all three dimension tables are loaded — INNER JOIN SK lookups require complete dimension data.",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "exec_usp_Load_DimCustomer",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "exec_usp_Load_DimProduct",
            "dependencyConditions": ["Succeeded"]
          },
          {
            "activity": "exec_usp_Load_DimStore",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "storedProcedureName": "gold.usp_Load_FactSales"
        },
        "linkedServiceName": {
          "referenceName": "5745b65d-7345-433c-ada0-4d9c6f1f6554",
          "type": "LinkedServiceReference"
        }
      }

    ],
    "annotations": [],
    "concurrency": 1,
    "policy": {
      "elapsedTimeMetric": {}
    }
  }
}
