[flake8]
max-line-length = 120

# E203: whitespace before ':' (conflicts with black-style slice formatting)
# W503: line break before binary operator (PEP8 updated guidance)
# E501: line too long (handled by max-line-length above)
extend-ignore = E203, W503

exclude =
    .git,
    __pycache__,
    .ipynb_checkpoints,
    venv,
    .venv,
    dist,
    build

# Notebooks often have imports not at top of file (cell-by-cell execution)
per-file-ignores =
    *.ipynb: E402
